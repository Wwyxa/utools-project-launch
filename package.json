{
  "name": "utools-project-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3421 --host=0.0.0.0",
    "build": "vite build",
    "go:fmt": "go -C service fmt ./...",
    "go:vet": "go -C service vet ./...",
    "go:test": "go -C service test ./...",
    "go:build": "node scripts/build-project-launch-service.mjs",
    "test:git-diff": "vitest run tests/gitDiff.test.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "validate:ai-reasoning": "node scripts/validate-ai-reasoning.mjs",
    "benchmark:git-interactions": "node scripts/benchmark-git-interactions.mjs",
    "benchmark:service-resources": "node scripts/benchmark-service-resources.mjs",
    "validate:git-commits": "node scripts/validate-git-commits.mjs",
    "validate:git-diff": "node scripts/validate-git-diff.mjs",
    "validate:git-workspace": "vitest run tests/projectBridge.workspace.test.ts && node scripts/validate-git-workspace.mjs",
    "validate:project-files": "node scripts/validate-project-files.mjs",
    "validate:project-storage": "node scripts/validate-project-storage-compat.mjs",
    "validate:process-results": "node scripts/validate-process-result-batches.mjs"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.479.0",
    "markdown-it": "^14.1.1",
    "overlayscrollbars": "^2.16.0",
    "pinia": "^2.3.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
